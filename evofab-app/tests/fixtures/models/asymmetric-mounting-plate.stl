solid asymmetric_mounting_plate
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 120 30 0
      vertex 120 0 0
    endloop
  endfacet
  facet normal 0 0 -1
    outer loop
      vertex 0 0 0
      vertex 0 30 0
      vertex 120 30 0
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 4
      vertex 120 0 4
      vertex 120 30 4
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 0 0 4
      vertex 120 30 4
      vertex 0 30 4
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 120 0 0
      vertex 120 0 4
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex 0 0 0
      vertex 120 0 4
      vertex 0 0 4
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 120 0 0
      vertex 120 30 0
      vertex 120 30 4
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 120 0 0
      vertex 120 30 4
      vertex 120 0 4
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 120 30 0
      vertex 0 30 0
      vertex 0 30 4
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 120 30 0
      vertex 0 30 4
      vertex 120 30 4
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 30 0
      vertex 0 0 0
      vertex 0 0 4
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex 0 30 0
      vertex 0 0 4
      vertex 0 30 4
    endloop
  endfacet
endsolid asymmetric_mounting_plate
