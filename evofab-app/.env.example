# Local Supabase (created by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Printer transport. Keep mock as the committed default.
MOONRAKER_MODE=mock
MOCK_MOONRAKER_URL=http://127.0.0.1:7125
MOONRAKER_TIMEOUT_MS=3000

# Only required by explicit hardware tools. Never commit a real value.
# HARDWARE_CONFIRMATION=I_UNDERSTAND_THIS_CONTROLS_PHYSICAL_HARDWARE
# RUN_HARDWARE_TESTS=false
# HARDWARE_PRINTER_ID=
# HARDWARE_PRINTER_IP=
# HARDWARE_PRINTER_PORT=80
